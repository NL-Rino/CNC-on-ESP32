# ---- Bat buoc ----
# Lay key tai https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ---- Rat nen dat khi deploy public ----
# Mat khau dang nhap. De trong = AI KHONG CO MAT KHAU -> nguoi la xai het credit cua ban.
APP_PASSWORD=doi-mat-khau-nay-di

# ---- Tuy chon ----
MODEL=claude-opus-5
# low | medium | high | xhigh | max  (cang cao cang suy luan sau, cang ton token)
EFFORT=high
MAX_TOKENS=32000
# So vong tool toi da trong 1 luot tra loi
MAX_TOOL_ROUNDS=25
# So tin nhan giu lai trong lich su moi phien
MAX_HISTORY=40

# Bat/tat tung tool
ENABLE_PYTHON=true
ENABLE_FILES=true
ENABLE_HTTP=true
ENABLE_WEB=true
# Shell tu do - NGUY HIEM tren host public. Chi bat khi ban hieu ro.
ENABLE_SHELL=false

# Gioi han chay code
EXEC_TIMEOUT=30
EXEC_MEMORY_MB=512

# Thu muc lam viec cua agent
WORKSPACE=./workspace
